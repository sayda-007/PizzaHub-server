# Copy this file to .env and replace the placeholder values locally.
# NEVER commit .env. Secrets belong on the server only.

# --- HTTP server -----------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database (REQUIRED) ----------------------------------------------------
# MongoDB Atlas connection string. Replace the placeholders with your own
# Atlas credentials and cluster host. Never commit the real value.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# The database inside that cluster. The driver selects it on connect.
MONGODB_DB_NAME=pizzahub

# --- Better Auth (REQUIRED) --------------------------------------------------
# Generate a random secret of at least 32 characters, for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never reuse the example value below; placeholder secrets are rejected at startup.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public URL of this API (used as the OAuth callback base URL).
BETTER_AUTH_URL=http://localhost:5000
# Trusted browser origin of the future Next.js client.
CLIENT_URL=http://localhost:3000

# --- Google OAuth (OPTIONAL) -------------------------------------------------
# Leave BOTH lines unset/empty for local development without Google sign-in.
# Supplying only one of them is a configuration error; placeholder values are
# rejected. Use real credentials from Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Stripe Premium subscriptions -------------------------------------------
# All three values are required together; placeholders are ignored at startup
# and Premium endpoints then return a safe "not configured" error. Use test-mode
# values locally. Never commit real keys, webhook secrets, or price ids.
# Local webhook endpoint: http://localhost:5000/api/webhooks/stripe
# Production webhook endpoint: https://<your-api-domain>/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET is the whsec_... value printed by the Stripe CLI or
# shown by the Stripe Dashboard endpoint. Subscribe to checkout.session.completed,
# invoice.paid, invoice.payment_failed, customer.subscription.updated and
# customer.subscription.deleted.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Use a test-mode recurring Price ID, never a live price or a client-supplied id.
STRIPE_PREMIUM_PRICE_ID=price_replace_me
# Checkout success/cancel redirects reuse the trusted CLIENT_URL above.

# --- ImgBB image uploads (required for vendor menu images) ------------------
# Replace this placeholder with a real ImgBB API key. It is optional at server
# startup, but any menu image upload attempt fails safely while it is a
# placeholder or missing. Never commit the real key.
IMGBB_API_KEY=replace-with-imgbb-api-key

# --- Admin seed script (manual) ---------------------------------------------
# Replace all three values before running `npm run seed:admin`.
# example.com addresses are rejected; replace ADMIN_EMAIL with a real email.
# The password must be 6-128 characters and include at least one uppercase
# and one lowercase letter.
ADMIN_NAME=PizzaHub Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
