# Copy this file to .env and replace the placeholder values locally.
# NEVER commit .env. Secrets belong on the server only.

# --- HTTP server -----------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database (Milestone 3) -------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/pizzahub
MONGODB_DB_NAME=pizzahub

# --- Better Auth (Milestone 4) ----------------------------------------------
# Generate a long random value for the secret; do not reuse this placeholder.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# --- Google OAuth (Milestone 4) ---------------------------------------------
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# --- Stripe, test mode only (Milestone 13) ----------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# --- ImgBB (Milestone 7) ----------------------------------------------------
IMGBB_API_KEY=replace-with-imgbb-api-key

# --- Admin seed script (Milestone 6) ----------------------------------------
ADMIN_NAME=PizzaHub Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
